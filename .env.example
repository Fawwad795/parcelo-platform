# Copy this file to .env and adjust. The real .env is ignored by git and must
# stay that way: `git status` should never show it.
#
#   cp .env.example .env
#
# These values are for LOCAL development only. Nothing here is a real secret,
# and no real secret ever belongs in this file, in the repository, or in a
# workflow file. Cloud credentials come from `aws login` on your laptop and
# from OIDC in GitHub Actions (Week 3), never from a file.

# --- PostgreSQL (used by docker-compose.yml) --------------------------------
POSTGRES_USER=parcelo
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=parcelo

# --- Application --------------------------------------------------------------
# Shown by GET /version. Your pipeline sets this to the commit SHA.
GIT_SHA=dev
LOG_LEVEL=INFO

# --- Chaos switches (drills only; keep them off otherwise) --------------------
# CHAOS_FAIL_READY=true       # readiness returns 503, liveness stays 200
# CHAOS_CRASH_ON_START=true   # the process refuses to start
# CHAOS_ERROR_RATE=0.3        # 30 percent of /api requests return 500

# --- Running the app WITHOUT Compose (optional) -------------------------------
# `uvicorn app.main:app --reload` reads DATABASE_URL from here. Leave it unset
# to use a local SQLite file, or point it at the Compose database:
# DATABASE_URL=postgresql+psycopg://parcelo:local-dev-only-change-me@localhost:5432/parcelo
